//Faça um programa que permita ao usuário digitar o seu nome e 
//em seguida mostre o nome do usuário de trás para frente 

#include <stdio.h>
#include <string.h>
int main()
{
    char nome[50];
    int i, cmp=0;
    
    printf("\nInsira seu nome:");
    fgets(nome, sizeof(nome), stdin);
    
    printf("\nBem vindo, %s!", nome);
    printf("\nComprimento do  seu nome:%d", strlen(nome)-1);
    
    printf("\n------------------------------------------------------------");
    printf("\nNome Ao Contrario!");
    
    cmp = strlen(nome);
    for(i=cmp-1;i<strlen(nome); i--)
    {
        printf("%c", nome[i]);
    }
}
